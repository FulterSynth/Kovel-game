<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>КОВЕЛЬ: Стратегія</title>
    <!-- Підключаємо стилі Leaflet для карти -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body, html { height: 100%; overflow: hidden; background: #0f172a; color: #fff; }

        /* Екран завантаження оновлення / лоадер */
        #update-loader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #0f172a; display: flex; justify-content: center; align-items: center; z-index: 2000;
            transition: opacity 0.5s ease;
        }
        .loader-content {
            text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px;
        }
        .spinner {
            width: 50px; height: 50px; border: 5px solid #334155; border-top: 5px solid #38bdf8;
            border-radius: 50%; animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .loader-content h2 { color: #f8fafc; font-size: 22px; }
        .loader-content p { color: #94a3b8; font-size: 14px; }

        /* Екран авторизації */
        #auth-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #1e293b; display: flex; justify-content: center; align-items: center; z-index: 1000;
        }
        .auth-box {
            background: #334155; padding: 30px; border-radius: 12px; width: 320px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3); display: flex; flex-direction: column; gap: 15px;
        }
        .auth-box h2 { text-align: center; margin-bottom: 5px; color: #fff; }
        .auth-box input {
            padding: 12px; border-radius: 6px; border: 1px solid #475569;
            background: #1e293b; color: #fff; outline: none;
        }
        .auth-box button {
            padding: 12px; border-radius: 6px; border: none; background: #3b82f6;
            color: #fff; font-weight: bold; cursor: pointer; transition: background 0.2s;
        }
        .auth-box button:hover { background: #2563eb; }
        .auth-toggle { text-align: center; font-size: 13px; color: #94a3b8; cursor: pointer; margin-top: 5px; }
        .auth-toggle:hover { color: #38bdf8; text-decoration: underline; }

        /* Головний контейнер гри */
        #game-container { display: none; height: 100%; flex-direction: column; }

        /* Сторінки */
        .page { display: none; flex: 1; position: relative; }
        .page.active { display: flex; flex-direction: column; }

        /* Стиль для карти */
        #map { width: 100%; height: 100%; background: #ffffff; }

        /* Стилі для сторінки ЧАТУ */
        #page-chat {
            background: #0f172a; display: flex; flex-direction: column; height: 100%; padding: 15px;
        }
        .chat-messages {
            flex: 1; background: #1e293b; border-radius: 8px; padding: 15px;
            overflow-y: auto; display: flex; flex-direction: column; gap: 10px; border: 1px solid #334155;
        }
        .chat-msg {
            background: #334155; padding: 10px 14px; border-radius: 8px; max-width: 80%; word-break: break-word;
        }
        .chat-msg .author { font-size: 11px; color: #38bdf8; margin-bottom: 3px; font-weight: bold; }
        .chat-msg .text { font-size: 14px; color: #f8fafc; }
        .chat-input-area {
            display: flex; gap: 10px; margin-top: 15px;
        }
        .chat-input-area input {
            flex: 1; padding: 12px; border-radius: 8px; border: 1px solid #475569;
            background: #1e293b; color: #fff; outline: none; font-size: 14px;
        }
        .chat-input-area button {
            padding: 0 20px; border-radius: 8px; border: none; background: #3b82f6;
            color: #fff; font-weight: bold; cursor: pointer; transition: background 0.2s;
        }
        .chat-input-area button:hover { background: #2563eb; }

        /* Нижня панель навігації (Clash Royale style) */
        .nav-bar {
            height: 70px; background: #1e293b; display: flex;
            justify-content: space-around; align-items: center;
            border-top: 2px solid #334155; z-index: 999; flex-shrink: 0;
        }
        .nav-btn {
            background: none; border: none; color: #94a3b8; font-size: 13px;
            cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px;
            transition: color 0.2s;
        }
        .nav-btn.active { color: #38bdf8; font-weight: bold; }
    </style>
</head>
<body>

    <!-- Екран завантаження оновлення -->
    <div id="update-loader">
        <div class="loader-content">
            <div class="spinner"></div>
            <h2 id="loader-status">Застосування оновлення v1.1 (Чат гравців)...</h2>
            <p>Оновлення інтерфейсу та ігрових модулів Ковеля</p>
        </div>
    </div>

    <!-- Екран Авторизації / Реєстрації -->
    <div id="auth-screen">
        <div class="auth-box">
            <h2 id="auth-title">Вхід у гру</h2>
            <input type="text" id="username" placeholder="Логін">
            <input type="password" id="password" placeholder="Пароль">
            <button id="auth-btn" onclick="handleAuth()">Увійти</button>
            <div class="auth-toggle" onclick="toggleAuthMode()">Ще немає акаунта? Зареєструватись</div>
        </div>
    </div>

    <!-- Ігровий інтерфейс -->
    <div id="game-container">
        <!-- Сторінка 1: Мапа Ковеля -->
        <div id="page-map" class="page active">
            <div id="map"></div>
        </div>

        <!-- Сторінка 2: База / Профіль -->
        <div id="page-base" class="page" style="justify-content: center; align-items: center; background: #f8fafc; color: #1e293b;">
            <h1 id="player-greeting">Головна база гравця</h1>
            <p>Тут будуть покращення будівель, ресурси та території.</p>
        </div>

        <!-- Сторінка 3: Чат гравців -->
        <div id="page-chat" class="page">
            <h2 style="margin-bottom: 10px; font-size: 18px; color: #38bdf8;">💬 Загальний чат Ковеля</h2>
            <div class="chat-messages" id="chat-messages">
                <!-- Повідомлення з'являтимуться тут -->
            </div>
            <div class="chat-input-area">
                <input type="text" id="chat-input" placeholder="Напишіть повідомлення..." onkeypress="handleChatKeyPress(event)">
                <button onclick="sendChatMessage()">Надіслати</button>
            </div>
        </div>

        <!-- Сторінка 4: Бої / Території -->
        <div id="page-battles" class="page" style="justify-content: center; align-items: center; background: #f8fafc; color: #1e293b;">
            <h1>Арена Ковеля</h1>
            <p>Захоплюйте вулиці та змагайтесь з іншими гравцями.</p>
        </div>

        <!-- Нижня панель навігації -->
        <div class="nav-bar">
            <button class="nav-btn active" onclick="switchPage('map', this)">🗺️ Мапа</button>
            <button class="nav-btn" onclick="switchPage('base', this)">🏰 База</button>
            <button class="nav-btn" onclick="switchPage('chat', this)">💬 Чат</button>
            <button class="nav-btn" onclick="switchPage('battles', this)">⚔️ Арена</button>
        </div>
    </div>

    <!-- Підключаємо скрипт Leaflet -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map;
        let isRegisterMode = false;
        let currentUsername = "";

        // Імітація завантаження оновлення v1.1
        window.addEventListener('load', () => {
            setTimeout(() => {
                const loader = document.getElementById('update-loader');
                loader.style.opacity = '0';
                setTimeout(() => loader.style.display = 'none', 500);
            }, 1000);
        });

        function toggleAuthMode() {
            isRegisterMode = !isRegisterMode;
            document.getElementById('auth-title').innerText = isRegisterMode ? 'Реєстрація' : 'Вхід у гру';
            document.getElementById('auth-btn').innerText = isRegisterMode ? 'Створити акаунт' : 'Увійти';
            document.querySelector('.auth-toggle').innerText = isRegisterMode ? 'Вже є акаунт? Увійти' : 'Ще немає акаунта? Зареєструватись';
        }

        function handleAuth() {
            const user = document.getElementById('username').value.trim();
            const pass = document.getElementById('password').value.trim();
            
            if(!user || !pass) {
                alert('Будь ласка, заповніть усі поля!');
                return;
            }

            if(isRegisterMode) {
                if(localStorage.getItem('user_' + user)) {
                    alert('Такий користувач вже існує!');
                    return;
                }
                localStorage.setItem('user_' + user, pass);
                alert('Акаунт успішно створено! Тепер увійдіть.');
                toggleAuthMode();
            } else {
                const savedPass = localStorage.getItem('user_' + user);
                if(!savedPass || savedPass !== pass) {
                    alert('Невірний логін або пароль!');
                    return;
                }
                
                currentUsername = user;
                document.getElementById('auth-screen').style.display = 'none';
                document.getElementById('game-container').style.display = 'flex';
                document.getElementById('player-greeting').innerText = `База гравця: ${user}`;
                
                // Додаємо вітальне повідомлення в чат
                addSystemMessage(`Гравець ${user} увійшов у гру.`);
                initMap();
            }
        }

        function initMap() {
            if (map) return;
            const kovelCoords = [51.2176, 24.7042];
            
            map = L.map('map', { zoomControl: false }).setView(kovelCoords, 14);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
            }).addTo(map);

            L.marker(kovelCoords).addTo(map)
              .bindPopup('<b>Ваша стартова позиція у Ковелі</b>')
              .openPopup();
        }

        function switchPage(pageId, btn) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById('page-' + pageId).classList.add('active');

            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            if(pageId === 'map' && map) {
                setTimeout(() => map.invalidateSize(), 100);
            }
        }

        // Логіка чату
        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if(!text) return;

            appendMessage(currentUsername, text);
            input.value = '';
        }

        function handleChatKeyPress(e) {
            if(e.key === 'Enter') {
                sendChatMessage();
            }
        }

        function appendMessage(author, text) {
            const chatMessages = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            msgDiv.className = 'chat-msg';
            msgDiv.innerHTML = `<div class="author">${author}</div><div class="text">${escapeHtml(text)}</div>`;
            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function addSystemMessage(text) {
            const chatMessages = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            msgDiv.style.textAlign = 'center';
            msgDiv.style.color = '#94a3b8';
            msgDiv.style.fontSize = '12px';
            msgDiv.style.margin = '5px 0';
            msgDiv.innerText = text;
            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>
